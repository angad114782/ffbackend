exports.createUser = async (req, res, next) => {
  const t = await sequelize.transaction();
  try {
    const { file, body } = await UploadFile(req, "/assets");
    const user = await User.findOne({
      where: {
        [Op.or]: [{ phone: req.body.phone }, { email: req.body.email }],
        type: req.body.type,
      },
    });
    if (user) {
      return res.status(400).json({
        message: "User Already Exists",
        status: false,
      });
    }
    if (body.type == "sales-person") {
      const hashedPassword = await bcryptjs.hash(req.body.password, 12);
      const newUser = await User.create(
        {
          userId: body.userId,
          firstName: body.firstName,
          lastName: body.lastName,
          phone: body.phone,
          email: body.email,
          password: hashedPassword,
          type: body.type,
          image: file.path,
        },
        { transaction: t },
      );

      await OutletUser.create(
        {
          outletId: req.body.outletId,
          salesPersonId: newUser.dataValues.id,
        },
        { transaction: t },
      );

      await t.commit();

      return res.status(200).json({
        message: `New ${newUser.type} Created`,
        data: newUser,
        status: true,
      });
    } else {
      const hashedPassword = await bcryptjs.hash(req.body.password, 12);
      const newUser = await User.create(
        {
          userId: body.userId,
          firstName: body.firstName,
          lastName: body.lastName,
          phone: body.phone,
          email: body.email,
          password: hashedPassword,
          type: body.type,
          image: file.path,
          vendorId: req.body.vendorId,
        },
        { transaction: t },
      );

      if (body.type == "outlet") {
        await OutletAddress.create(
          {
            street: req.body.street,
            city: req.body.city,
            state: req.body.state,
            pincode: req.body.pincode,
            userId: newUser.dataValues.id,
          },
          { transaction: t },
        );
      }

      await t.commit();
      res.status(200).json({
        message: `New ${newUser.type} Created`,
        data: newUser,
        status: true,
      });
    }
  } catch (err) {
    if (!err.statusCode) {
      err.statusCode = 500;
    }
    await t.rollback();
    next(err);
  }
};
